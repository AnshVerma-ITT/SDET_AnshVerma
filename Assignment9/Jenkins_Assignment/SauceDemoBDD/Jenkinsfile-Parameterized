pipeline {
    agent any

    parameters {
        choice(
            name: 'BROWSER',
            choices: ['Chromium', 'WebKit'],
            description: 'Select the browser for SauceDemoBDD test execution.'
        )

        string(
            name: 'EMAIL',
            defaultValue: 'anshav14@gmail.com',
            description: 'Email address for Jenkins build notification.'
        )

        string(
            name: 'RETRY_COUNT',
            defaultValue: '2',
            description: 'Number of times to retry failed test execution.'
        )
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'Assignment9',
                    url: 'https://github.com/AnshVerma-ITT/SDET_AnshVerma.git'
            }
        }

        stage('Restore') {
            steps {
                dir('Assignment9/Jenkins_Assignment/SauceDemoBDD') {
                    bat 'dotnet restore'
                }
            }
        }

        stage('Build') {
            steps {
                dir('Assignment9/Jenkins_Assignment/SauceDemoBDD') {
                    bat 'dotnet build --no-restore'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Assignment9/Jenkins_Assignment/SauceDemoBDD') {

                    script {

                        int retries = params.RETRY_COUNT as Integer

                        echo "========================================"
                        echo "Running SauceDemoBDD Tests"
                        echo "Selected Browser : ${params.BROWSER}"
                        echo "Retry Count      : ${retries}"
                        echo "========================================"

                        int attempt = 0
                        boolean testPassed = false

                        while (attempt <= retries && !testPassed) {

                            attempt++

                            echo "========================================"
                            echo "Test Execution Attempt: ${attempt}"
                            echo "========================================"

                            try {

                                bat """
                                    echo Running tests - Attempt ${attempt}

                                    set BROWSER=${params.BROWSER}

                                    dotnet test --no-build ^
                                      --logger:"trx;LogFileName=test-results.trx" ^
                                      --results-directory:"TestResults"
                                """

                                testPassed = true

                                echo "Tests passed on attempt ${attempt}."

                            } catch (Exception e) {

                                echo "Tests failed on attempt ${attempt}."

                                if (attempt <= retries) {
                                    echo "Retrying tests..."
                                } else {
                                    echo "Maximum retry attempts reached."
                                    throw e
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Generate HTML Report') {
            steps {
                script {

                    writeFile(
                        file: 'Assignment9/Jenkins_Assignment/SauceDemoBDD/TestResults/test-report.html',
                        text: """
<!DOCTYPE html>

<html>

<head>

    <meta charset="UTF-8">

    <title>SauceDemoBDD Jenkins Test Report</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            margin: 40px;
            background-color: #f8f9fa;
            color: #333;
        }

        h1 {
            color: #2c3e50;
        }

        h2 {
            color: #34495e;
            margin-top: 30px;
        }

        table {
            border-collapse: collapse;
            width: 90%;
            background-color: white;
            margin-bottom: 25px;
        }

        th, td {
            border: 1px solid #999;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: #eeeeee;
        }

        .success {
            font-weight: bold;
            color: green;
        }

        .failed {
            font-weight: bold;
            color: red;
        }

        .test-number {
            width: 15%;
        }

        .description {
            width: 60%;
        }

        .feature {
            width: 25%;
        }

        a {
            color: #0066cc;
        }

    </style>

</head>

<body>

    <h1>SauceDemoBDD Jenkins Test Report</h1>

    <h2>Build Information</h2>

    <table>

        <tr>
            <th>Job Name</th>
            <td>${env.JOB_NAME}</td>
        </tr>

        <tr>
            <th>Build Number</th>
            <td>${env.BUILD_NUMBER}</td>
        </tr>

        <tr>
            <th>Browser</th>
            <td>${params.BROWSER}</td>
        </tr>

        <tr>
            <th>Email</th>
            <td>${params.EMAIL}</td>
        </tr>

        <tr>
            <th>Retry Count</th>
            <td>${params.RETRY_COUNT}</td>
        </tr>

        <tr>
            <th>Build Status</th>

            <td class="${currentBuild.currentResult == 'SUCCESS' ? 'success' : 'failed'}">
                ${currentBuild.currentResult}
            </td>

        </tr>

        <tr>
            <th>Build URL</th>

            <td>
                <a href="${env.BUILD_URL}">
                    ${env.BUILD_URL}
                </a>
            </td>

        </tr>

    </table>


    <h2>Test Execution</h2>

    <p>
        SauceDemoBDD automated tests were executed using:
    </p>

    <ul>
        <li>C#</li>
        <li>.NET 10</li>
        <li>NUnit</li>
        <li>Reqnroll BDD</li>
        <li>Microsoft Playwright</li>
    </ul>


    <h2>Test Cases</h2>

    <table>

        <tr>
            <th class="test-number">Test Case No.</th>
            <th class="description">Description</th>
            <th class="feature">Feature</th>
        </tr>

        <tr>
            <td>TC-AUTH-001</td>
            <td>Login with the standard user</td>
            <td>Authentication</td>
        </tr>

        <tr>
            <td>TC-AUTH-002</td>
            <td>Reject invalid username credentials</td>
            <td>Authentication</td>
        </tr>

        <tr>
            <td>TC-AUTH-003</td>
            <td>Reject invalid password credentials</td>
            <td>Authentication</td>
        </tr>

        <tr>
            <td>TC-AUTH-004</td>
            <td>Reject missing username credentials</td>
            <td>Authentication</td>
        </tr>

        <tr>
            <td>TC-AUTH-005</td>
            <td>Reject missing password credentials</td>
            <td>Authentication</td>
        </tr>

        <tr>
            <td>TC-AUTH-006</td>
            <td>Reject locked user credentials</td>
            <td>Authentication</td>
        </tr>

        <tr>
            <td>TC-CHK-001</td>
            <td>Complete the Week 6 purchase journey</td>
            <td>Checkout</td>
        </tr>

        <tr>
            <td>TC-CHK-002</td>
            <td>Reject missing first name</td>
            <td>Checkout</td>
        </tr>

        <tr>
            <td>TC-CHK-003</td>
            <td>Reject missing last name</td>
            <td>Checkout</td>
        </tr>

        <tr>
            <td>TC-CHK-004</td>
            <td>Reject missing postal code</td>
            <td>Checkout</td>
        </tr>

        <tr>
            <td>TC-INV-001</td>
            <td>Sort products by price from low to high</td>
            <td>Inventory &amp; Cart</td>
        </tr>

        <tr>
            <td>TC-INV-002</td>
            <td>Add selected products and retain them after continuing shopping</td>
            <td>Inventory &amp; Cart</td>
        </tr>

        <tr>
            <td>TC-INV-003</td>
            <td>Remove a product from the inventory</td>
            <td>Inventory &amp; Cart</td>
        </tr>

    </table>


    <h2>Test Case Summary</h2>

    <table>

        <tr>
            <th>Total Test Cases</th>
            <td>13</td>
        </tr>

        <tr>
            <th>Authentication Test Cases</th>
            <td>6</td>
        </tr>

        <tr>
            <th>Checkout Test Cases</th>
            <td>4</td>
        </tr>

        <tr>
            <th>Inventory &amp; Cart Test Cases</th>
            <td>3</td>
        </tr>

    </table>


    <h2>Test Result</h2>

    <p>
        The detailed test execution result is available in the
        archived TRX file generated by <strong>dotnet test</strong>.
    </p>

    <p>
        Jenkins Build:
        ${env.JOB_NAME} #${env.BUILD_NUMBER}
    </p>

    <p>
        <a href="${env.BUILD_URL}">
            Open Jenkins Build
        </a>
    </p>

</body>

</html>
"""
                    )
                }
            }
        }


        stage('Archive Results') {
            steps {

                archiveArtifacts(
                    artifacts: 'Assignment9/Jenkins_Assignment/SauceDemoBDD/TestResults/**/*',
                    allowEmptyArchive: true
                )

            }
        }
    }


    post {

        always {

            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'Assignment9/Jenkins_Assignment/SauceDemoBDD/TestResults',
                reportFiles: 'test-report.html',
                reportName: 'SauceDemoBDD HTML Report',
                escapeUnderscores: false
            ])

            echo "========================================"
            echo "Jenkins Build Completed"
            echo "========================================"
            echo "Job Name         : ${env.JOB_NAME}"
            echo "Build Number     : ${env.BUILD_NUMBER}"
            echo "Build Status     : ${currentBuild.currentResult}"
            echo "Selected Browser : ${params.BROWSER}"
            echo "Build URL        : ${env.BUILD_URL}"
            echo "========================================"
        }


        success {

            echo 'SauceDemoBDD tests completed successfully.'

            mail(
                to: params.EMAIL,
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                mimeType: 'text/html',

                body: """
<html>

<body>

    <h2>SauceDemoBDD Jenkins Build - SUCCESS</h2>

    <table border="1" cellpadding="8" cellspacing="0">

        <tr>
            <th>Job Name</th>
            <td>${env.JOB_NAME}</td>
        </tr>

        <tr>
            <th>Build Number</th>
            <td>${env.BUILD_NUMBER}</td>
        </tr>

        <tr>
            <th>Browser</th>
            <td>${params.BROWSER}</td>
        </tr>

        <tr>
            <th>Retry Count</th>
            <td>${params.RETRY_COUNT}</td>
        </tr>

        <tr>
            <th>Status</th>
            <td>SUCCESS</td>
        </tr>

        <tr>
            <th>Build URL</th>

            <td>
                <a href="${env.BUILD_URL}">
                    Open Jenkins Build
                </a>
            </td>

        </tr>

    </table>

    <br>

    <h3>Test Summary</h3>

    <p>
        Total Test Cases: <strong>13</strong>
    </p>

    <p>
        Authentication: <strong>6</strong> test cases
    </p>

    <p>
        Checkout: <strong>4</strong> test cases
    </p>

    <p>
        Inventory &amp; Cart: <strong>3</strong> test cases
    </p>

    <p>
        SauceDemoBDD automated tests completed successfully.
    </p>

    <p>
        The detailed HTML report and TRX test result
        are available in the Jenkins build artifacts.
    </p>

</body>

</html>
"""
            )
        }


        failure {

            echo 'SauceDemoBDD pipeline failed. Check Jenkins Console Output and archived test results.'

            mail(
                to: params.EMAIL,
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                mimeType: 'text/html',

                body: """
<html>

<body>

    <h2>SauceDemoBDD Jenkins Build - FAILED</h2>

    <table border="1" cellpadding="8" cellspacing="0">

        <tr>
            <th>Job Name</th>
            <td>${env.JOB_NAME}</td>
        </tr>

        <tr>
            <th>Build Number</th>
            <td>${env.BUILD_NUMBER}</td>
        </tr>

        <tr>
            <th>Browser</th>
            <td>${params.BROWSER}</td>
        </tr>

        <tr>
            <th>Retry Count</th>
            <td>${params.RETRY_COUNT}</td>
        </tr>

        <tr>
            <th>Status</th>
            <td>FAILED</td>
        </tr>

        <tr>
            <th>Build URL</th>

            <td>
                <a href="${env.BUILD_URL}">
                    Open Jenkins Build
                </a>
            </td>

        </tr>

    </table>

    <br>

    <h3>Test Summary</h3>

    <p>
        Total Test Cases: <strong>13</strong>
    </p>

    <p>
        Authentication: <strong>6</strong> test cases
    </p>

    <p>
        Checkout: <strong>4</strong> test cases
    </p>

    <p>
        Inventory &amp; Cart: <strong>3</strong> test cases
    </p>

    <p>
        SauceDemoBDD pipeline execution failed.
    </p>

    <p>
        Please check the Jenkins Console Output and
        archived test results for details.
    </p>

</body>

</html>
"""
            )
        }
    }
}