pipeline {
    agent any

    parameters {
        choice(
            name: 'BROWSER',
            choices: ['Chromium', 'WebKit'],
            description: 'Select the browser for SauceDemoBDD test execution.'
        )
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'Assignment9',
                    url: 'https://github.com/AnshVerma-ITT/SDET_AnshVerma.git'
            }
        }

        stage('Restore') {
            steps {
                dir('Assignment9/Jenkins_Assignment/SauceDemoBDD') {
                    bat 'dotnet restore'
                }
            }
        }

        stage('Build') {
            steps {
                dir('Assignment9/Jenkins_Assignment/SauceDemoBDD') {
                    bat 'dotnet build --no-restore'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Assignment9/Jenkins_Assignment/SauceDemoBDD') {
                    bat '''
                        echo ========================================
                        echo Running SauceDemoBDD Tests
                        echo Selected Browser: %BROWSER%
                        echo ========================================

                        set BROWSER=%BROWSER%

                        dotnet test --no-build ^
                          --logger:"trx;LogFileName=test-results.trx" ^
                          --results-directory:"TestResults"
                    '''
                }
            }
        }

        stage('Generate HTML Report') {
            steps {
                script {

                    writeFile(
                        file: 'Assignment9/Jenkins_Assignment/SauceDemoBDD/TestResults/test-report.html',
                        text: """
<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>SauceDemoBDD Jenkins Test Report</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            margin: 40px;
            background-color: #f8f9fa;
            color: #333;
        }

        h1 {
            color: #2c3e50;
        }

        h2 {
            color: #34495e;
            margin-top: 30px;
        }

        table {
            border-collapse: collapse;
            width: 80%;
            background-color: white;
        }

        th, td {
            border: 1px solid #999;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: #eeeeee;
            width: 25%;
        }

        .success {
            font-weight: bold;
            color: green;
        }

        .failed {
            font-weight: bold;
            color: red;
        }

        a {
            color: #0066cc;
        }

    </style>

</head>

<body>

    <h1>SauceDemoBDD Jenkins Test Report</h1>

    <table>

        <tr>
            <th>Job Name</th>
            <td>${env.JOB_NAME}</td>
        </tr>

        <tr>
            <th>Build Number</th>
            <td>${env.BUILD_NUMBER}</td>
        </tr>

        <tr>
            <th>Browser</th>
            <td>${params.BROWSER}</td>
        </tr>

        <tr>
            <th>Build Status</th>

            <td class="${currentBuild.currentResult == 'SUCCESS' ? 'success' : 'failed'}">
                ${currentBuild.currentResult}
            </td>

        </tr>

        <tr>
            <th>Build URL</th>

            <td>
                <a href="${env.BUILD_URL}">
                    ${env.BUILD_URL}
                </a>
            </td>

        </tr>

    </table>

    <h2>Test Execution</h2>

    <p>
        SauceDemoBDD automated tests were executed using:
    </p>

    <ul>
        <li>C#</li>
        <li>.NET 10</li>
        <li>NUnit</li>
        <li>Reqnroll BDD</li>
        <li>Microsoft Playwright</li>
    </ul>

    <h2>Test Result</h2>

    <p>
        The detailed test execution result is available in the
        archived TRX file generated by <strong>dotnet test</strong>.
    </p>

    <p>
        <a href="${env.BUILD_URL}">
            Open Jenkins Build
        </a>
    </p>

</body>

</html>
"""
                    )
                }
            }
        }

        stage('Archive Results') {
            steps {

                archiveArtifacts(
                    artifacts: 'Assignment9/Jenkins_Assignment/SauceDemoBDD/TestResults/**/*',
                    allowEmptyArchive: true
                )

            }
        }
    }

    post {

        always {

            publishHTML([
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'Assignment9/Jenkins_Assignment/SauceDemoBDD/TestResults',
                reportFiles: 'test-report.html',
                reportName: 'SauceDemoBDD HTML Report'
            ])

            echo "========================================"
            echo "Jenkins Build Completed"
            echo "========================================"
            echo "Job Name         : ${env.JOB_NAME}"
            echo "Build Number     : ${env.BUILD_NUMBER}"
            echo "Build Status     : ${currentBuild.currentResult}"
            echo "Selected Browser : ${params.BROWSER}"
            echo "Build URL        : ${env.BUILD_URL}"
            echo "========================================"
        }

        success {

            echo 'SauceDemoBDD tests completed successfully.'

            mail(
                to: 'anshav14@gmail.com',
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                mimeType: 'text/html',

                body: """
<html>

<body>

    <h2>SauceDemoBDD Jenkins Build - SUCCESS</h2>

    <table border="1" cellpadding="8" cellspacing="0">

        <tr>
            <th>Job Name</th>
            <td>${env.JOB_NAME}</td>
        </tr>

        <tr>
            <th>Build Number</th>
            <td>${env.BUILD_NUMBER}</td>
        </tr>

        <tr>
            <th>Browser</th>
            <td>${params.BROWSER}</td>
        </tr>

        <tr>
            <th>Status</th>
            <td>SUCCESS</td>
        </tr>

        <tr>
            <th>Build URL</th>

            <td>
                <a href="${env.BUILD_URL}">
                    Open Jenkins Build
                </a>
            </td>

        </tr>

    </table>

    <br>

    <p>
        SauceDemoBDD automated tests completed successfully.
    </p>

    <p>
        The detailed HTML report and TRX test result
        are available in the Jenkins build artifacts.
    </p>

</body>

</html>
"""
            )
        }

        failure {

            echo 'SauceDemoBDD pipeline failed. Check Jenkins Console Output and archived test results.'

            mail(
                to: 'anshav14@gmail.com',
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                mimeType: 'text/html',

                body: """
<html>

<body>

    <h2>SauceDemoBDD Jenkins Build - FAILED</h2>

    <table border="1" cellpadding="8" cellspacing="0">

        <tr>
            <th>Job Name</th>
            <td>${env.JOB_NAME}</td>
        </tr>

        <tr>
            <th>Build Number</th>
            <td>${env.BUILD_NUMBER}</td>
        </tr>

        <tr>
            <th>Browser</th>
            <td>${params.BROWSER}</td>
        </tr>

        <tr>
            <th>Status</th>
            <td>FAILED</td>
        </tr>

        <tr>
            <th>Build URL</th>

            <td>
                <a href="${env.BUILD_URL}">
                    Open Jenkins Build
                </a>
            </td>

        </tr>

    </table>

    <br>

    <p>
        SauceDemoBDD pipeline execution failed.
    </p>

    <p>
        Please check the Jenkins Console Output and
        archived test results for details.
    </p>

</body>

</html>
"""
            )
        }
    }
}