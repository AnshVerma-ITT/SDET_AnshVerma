# Copy only the variable names into your local environment. Do not commit values.
HRMS_USERNAME=
HRMS_PASSWORD=

# Optional runtime overrides
HRMS_BASE_URL=https://hrms.intimetec.com
# Supported values: Chromium, WebKit, Firefox
BROWSER_ENGINE_TYPE=Chromium
HEADLESS=false
TIMEOUT_MILLISECONDS=30000
RESPONSE_TIMEOUT_MILLISECONDS=60000
# Safety gates: keep false unless the run is explicitly approved.
ALLOW_PRODUCTION_MUTATIONS=false
ALLOW_ACCOUNT_RISK_TESTS=false
ALLOW_PRODUCTION_ARTIFACTS=false
