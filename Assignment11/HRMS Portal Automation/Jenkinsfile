pipeline {

    agent any

    parameters {

        choice(
            name: 'EXECUTION_MODE',
            choices: [
                'Parallel',
                'Sequential'
            ],
            description: 'Select test execution mode'
        )

        choice(
            name: 'BROWSER',
            choices: [
                'Chromium',
                'WebKit',
                'All'
            ],
            description: 'Select browser'
        )

        choice(
            name: 'TEST_CATEGORY',
            choices: [
                'All',
                'smoke',
                'regression'
            ],
            description: 'Select test category'
        )

        choice(
            name: 'RETRY_COUNT',
            choices: [
                '0',
                '1',
                '2',
                '3'
            ],
            description: 'Number of retries for failed tests'
        )
    }

    triggers {
        pollSCM('H/2 * * * *')
    }

    environment {
        PROJECT_FILE = 'Assignment11/HRMS Portal Automation/HRIntimeAutomation.csproj'
        PROJECT_DIRECTORY = 'Assignment11/HRMS Portal Automation'
        TEST_RESULTS = 'Assignment11/HRMS Portal Automation/TestResults'
        ALLURE_RESULTS = 'Assignment11/HRMS Portal Automation/Reports/allure-results'
    }

    stages {

        stage('Prepare') {

            steps {

                powershell '''
                    Write-Host "======================================"
                    Write-Host "HRMS Jenkins Pipeline"
                    Write-Host "Execution Mode : $env:EXECUTION_MODE"
                    Write-Host "Browser        : $env:BROWSER"
                    Write-Host "Category       : $env:TEST_CATEGORY"
                    Write-Host "Retry Count    : $env:RETRY_COUNT"
                    Write-Host "======================================"

                    $projectDirectory = "Assignment11/HRMS Portal Automation"

                    if (Test-Path "$projectDirectory/TestResults") {
                        Remove-Item "$projectDirectory/TestResults" -Recurse -Force
                    }

                    if (Test-Path "$projectDirectory/Reports/allure-results") {
                        Remove-Item "$projectDirectory/Reports/allure-results" -Recurse -Force
                    }

                    New-Item -ItemType Directory -Force -Path "$projectDirectory/TestResults" | Out-Null
                    New-Item -ItemType Directory -Force -Path "$projectDirectory/Reports/allure-results" | Out-Null
                '''
            }
        }

        stage('Restore') {

            steps {

                bat 'dotnet restore "%PROJECT_FILE%"'
            }
        }

        stage('Build') {

            steps {

                bat 'dotnet build "%PROJECT_FILE%" --no-restore'
            }
        }

        stage('Run Tests') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'hrms-login',
                        usernameVariable: 'HRMS_USERNAME',
                        passwordVariable: 'HRMS_PASSWORD'
                    )
                ]) {

                    powershell '''

                        Write-Host "======================================"
                        Write-Host "Starting Test Execution"
                        Write-Host "Credentials loaded from Jenkins"
                        Write-Host "======================================"

                        if ($env:EXECUTION_MODE -eq "Parallel") {

                            $env:PARALLEL_ENABLED = "true"
                            $env:PARALLEL_WORKERS = "3"

                            Write-Host "Parallel execution ENABLED"
                        }
                        else {

                            $env:PARALLEL_ENABLED = "false"
                            $env:PARALLEL_WORKERS = "1"

                            Write-Host "Parallel execution DISABLED"
                        }

                        $overallExitCode = 0

                        if ($env:BROWSER -eq "All") {

                            Write-Host "======================================"
                            Write-Host "Running tests on Chromium"
                            Write-Host "======================================"

                            $env:BROWSER = "Chromium"

                            $chromiumArgs = @(
                                "$env:PROJECT_FILE",
                                "--no-build",
                                "--logger",
                                "trx;LogFileName=chromium.trx"
                            )

                            if ($env:TEST_CATEGORY -ne "All") {

                                Write-Host "Running category: $env:TEST_CATEGORY"

                                $chromiumArgs += "--filter"
                                $chromiumArgs += "TestCategory=$env:TEST_CATEGORY"
                            }

                            dotnet test @chromiumArgs

                            if ($LASTEXITCODE -ne 0) {

                                $overallExitCode = $LASTEXITCODE

                                Write-Host "Chromium tests contain failures."
                            }

                            Write-Host "======================================"
                            Write-Host "Running tests on WebKit"
                            Write-Host "======================================"

                            $env:BROWSER = "WebKit"

                            $webkitArgs = @(
                                "$env:PROJECT_FILE",
                                "--no-build",
                                "--logger",
                                "trx;LogFileName=webkit.trx"
                            )

                            if ($env:TEST_CATEGORY -ne "All") {

                                $webkitArgs += "--filter"
                                $webkitArgs += "TestCategory=$env:TEST_CATEGORY"
                            }

                            dotnet test @webkitArgs

                            if ($LASTEXITCODE -ne 0) {

                                $overallExitCode = $LASTEXITCODE

                                Write-Host "WebKit tests contain failures."
                            }
                        }
                        else {

                            Write-Host "======================================"
                            Write-Host "Running tests on $env:BROWSER"
                            Write-Host "======================================"

                            $singleBrowserArgs = @(
                                "$env:PROJECT_FILE",
                                "--no-build",
                                "--logger",
                                "trx;LogFileName=initial.trx"
                            )

                            if ($env:TEST_CATEGORY -ne "All") {

                                Write-Host "Running category: $env:TEST_CATEGORY"

                                $singleBrowserArgs += "--filter"
                                $singleBrowserArgs += "TestCategory=$env:TEST_CATEGORY"
                            }

                            dotnet test @singleBrowserArgs

                            if ($LASTEXITCODE -ne 0) {

                                $overallExitCode = $LASTEXITCODE

                                Write-Host "Initial test execution contains failures."
                            }
                        }

                        Write-Host "======================================"
                        Write-Host "Initial Test Execution Completed"
                        Write-Host "Exit Code: $overallExitCode"
                        Write-Host "======================================"

                        # Do not fail the stage here.
                        # Failed tests are handled by the retry stage.
                    '''
                }
            }
        }

        stage('Retry Failed Tests') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'hrms-login',
                        usernameVariable: 'HRMS_USERNAME',
                        passwordVariable: 'HRMS_PASSWORD'
                    )
                ]) {

                    powershell '''

                        $retryCount = [int]$env:RETRY_COUNT

                        if ($retryCount -eq 0) {

                            Write-Host "Retry disabled."
                            exit 0
                        }

                        Write-Host "======================================"
                        Write-Host "Searching for Failed Tests"
                        Write-Host "======================================"

                        $trxFiles = @(
                            Get-ChildItem "$env:TEST_RESULTS" -Filter "*.trx" |
                            Where-Object {
                                $_.Name -eq "initial.trx" -or
                                $_.Name -eq "chromium.trx" -or
                                $_.Name -eq "webkit.trx"
                            }
                        )

                        if ($trxFiles.Count -eq 0) {

                            Write-Host "No TRX files found."
                            Write-Host "Nothing to retry."
                            exit 0
                        }

                        $failedTestNames = New-Object System.Collections.Generic.List[string]

                        foreach ($trxFile in $trxFiles) {

                            Write-Host "Reading: $($trxFile.Name)"

                            [xml]$trx = Get-Content $trxFile.FullName

                            $failedResults = @(
                                $trx.TestRun.Results.UnitTestResult |
                                Where-Object {
                                    $_.outcome -eq "Failed"
                                }
                            )

                            foreach ($failedResult in $failedResults) {

                                $testName = [string]$failedResult.testName

                                if (
                                    -not [string]::IsNullOrWhiteSpace($testName) -and
                                    -not $failedTestNames.Contains($testName)
                                ) {

                                    $failedTestNames.Add($testName)
                                }
                            }
                        }

                        if ($failedTestNames.Count -eq 0) {

                            Write-Host "No failed tests found."
                            exit 0
                        }

                        Write-Host "======================================"
                        Write-Host "Failed Tests"
                        Write-Host "======================================"

                        foreach ($testName in $failedTestNames) {

                            Write-Host "FAILED: $testName"
                        }

                        $remainingFailures = @($failedTestNames)

                        for (
                            $attempt = 1;
                            $attempt -le $retryCount;
                            $attempt++
                        ) {

                            if ($remainingFailures.Count -eq 0) {
                                break
                            }

                            Write-Host "======================================"
                            Write-Host "Retry Attempt $attempt"
                            Write-Host "Tests to retry: $($remainingFailures.Count)"
                            Write-Host "======================================"

                            $nextFailures = New-Object System.Collections.Generic.List[string]

                            foreach ($testName in $remainingFailures) {

                                Write-Host "Retrying: $testName"

                                $safeName = $testName -replace '[^a-zA-Z0-9_-]', '_'

                                $retryFileName =
                                    "retry_${attempt}_${safeName}.trx"

                                $retryArgs = @(
                                    "$env:PROJECT_FILE",
                                    "--no-build",
                                    "--filter",
                                    "FullyQualifiedName~$testName",
                                    "--logger",
                                    "trx;LogFileName=$retryFileName"
                                )

                                dotnet test @retryArgs

                                if ($LASTEXITCODE -ne 0) {

                                    Write-Host "FAILED AGAIN: $testName"

                                    $nextFailures.Add($testName)
                                }
                                else {

                                    Write-Host "PASSED ON RETRY: $testName"
                                }
                            }

                            $remainingFailures = @($nextFailures)
                        }

                        Write-Host "======================================"
                        Write-Host "Retry Summary"
                        Write-Host "======================================"

                        if ($remainingFailures.Count -gt 0) {

                            Write-Host "Tests still failing after retries:"

                            foreach ($testName in $remainingFailures) {

                                Write-Host "FAILED: $testName"
                            }
                        }
                        else {

                            Write-Host "All previously failed tests passed during retry."
                        }
                    '''
                }
            }
        }

        stage('Allure Report') {

            steps {

                script {

                    allure(
                        includeProperties: false,
                        jdk: '',
                        results: [
                            [
                                path: "${env.ALLURE_RESULTS}"
                            ]
                        ]
                    )
                }
            }
        }

        stage('Archive Results') {

            steps {

                archiveArtifacts(
                    artifacts: 'Assignment11/HRMS Portal Automation/TestResults/**/*.trx, Assignment11/HRMS Portal Automation/Screenshots/**/*, Assignment11/HRMS Portal Automation/Traces/**/*',
                    allowEmptyArchive: true
                )
            }
        }
    }

    post {

        always {

            script {

                def passedTests = 0
                def failedTests = 0
                def totalTests = 0

                def trxFiles = findFiles(
                    glob: 'Assignment11/HRMS Portal Automation/TestResults/*.trx'
                )

                /*
                 * Count only the initial browser executions.
                 * Retry TRX files are excluded from the initial test total.
                 */
                def initialTrxFiles = trxFiles.findAll {

                    it.name == 'initial.trx' ||
                    it.name == 'chromium.trx' ||
                    it.name == 'webkit.trx'
                }

                initialTrxFiles.each { trxFile ->

                    def trxContent = readFile(trxFile.path)

                    def passedMatch =
                        trxContent =~ /passed="(\d+)"/

                    def failedMatch =
                        trxContent =~ /failed="(\d+)"/

                    if (passedMatch.find()) {

                        passedTests +=
                            passedMatch[0][1].toInteger()
                    }

                    if (failedMatch.find()) {

                        failedTests +=
                            failedMatch[0][1].toInteger()
                    }
                }

                totalTests = passedTests + failedTests

                def buildStatus = currentBuild.currentResult

                def emailBody = """
HRMS Portal Automation - Jenkins Build

========================================
BUILD INFORMATION
========================================

Build Number   : ${env.BUILD_NUMBER}
Build Status   : ${buildStatus}
Build Duration : ${currentBuild.durationString}

========================================
TEST SUMMARY
========================================

Total Tests    : ${totalTests}
Passed Tests   : ${passedTests}
Failed Tests   : ${failedTests}

========================================
EXECUTION DETAILS
========================================

Browser        : ${params.BROWSER}
Execution Mode : ${params.EXECUTION_MODE}
Test Category  : ${params.TEST_CATEGORY}
Retry Count    : ${params.RETRY_COUNT}

========================================
REPORTS
========================================

Detailed Allure Report:
${env.BUILD_URL}allure/

Jenkins Build:
${env.BUILD_URL}

========================================
"""

                mail(
                    to: 'anshav14@gmail.com',
                    subject: "HRMS Automation - Build #${env.BUILD_NUMBER} - ${buildStatus}",
                    body: emailBody
                )
            }
        }
    }
}