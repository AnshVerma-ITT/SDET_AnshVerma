pipeline {

    agent any

    parameters {

        choice(
            name: 'EXECUTION_MODE',
            choices: [
                'Parallel',
                'Sequential'
            ],
            description: 'Select test execution mode'
        )

        choice(
            name: 'BROWSER',
            choices: [
                'Chromium',
                'WebKit',
                'All'
            ],
            description: 'Select browser'
        )

        choice(
            name: 'TEST_CATEGORY',
            choices: [
                'All',
                'smoke',
                'regression'
            ],
            description: 'Select test category'
        )

        choice(
            name: 'RETRY_COUNT',
            choices: [
                '0',
                '1',
                '2',
                '3'
            ],
            description: 'Number of retries for failed tests'
        )
    }

    triggers {
        pollSCM('H/2 * * * *')
    }

    environment {
        PROJECT_FILE = 'HRIntimeAutomation.csproj'
        TEST_RESULTS = 'TestResults'
        ALLURE_RESULTS = 'Reports/allure-results'
    }

    stages {

        stage('Prepare') {
            steps {
                powershell '''
                    Write-Host "======================================"
                    Write-Host "HRMS Jenkins Pipeline"
                    Write-Host "Execution Mode : $env:EXECUTION_MODE"
                    Write-Host "Browser        : $env:BROWSER"
                    Write-Host "Category       : $env:TEST_CATEGORY"
                    Write-Host "Retry Count    : $env:RETRY_COUNT"
                    Write-Host "======================================"

                    if (Test-Path "TestResults") {
                        Remove-Item "TestResults" -Recurse -Force
                    }

                    if (Test-Path "Reports/allure-results") {
                        Remove-Item "Reports/allure-results" -Recurse -Force
                    }

                    New-Item -ItemType Directory -Force -Path "TestResults" | Out-Null
                    New-Item -ItemType Directory -Force -Path "Reports/allure-results" | Out-Null
                '''
            }
        }

        stage('Restore') {
            steps {
                bat 'dotnet restore "%PROJECT_FILE%"'
            }
        }

        stage('Build') {
            steps {
                bat 'dotnet build "%PROJECT_FILE%" --no-restore'
            }
        }

        stage('Run Tests') {
            steps {
                powershell '''
                    if ($env:EXECUTION_MODE -eq "Parallel") {
                        $env:PARALLEL_ENABLED = "true"
                        $env:PARALLEL_WORKERS = "3"
                    }
                    else {
                        $env:PARALLEL_ENABLED = "false"
                        $env:PARALLEL_WORKERS = "1"
                    }

                    $categoryArgument = ""

                    if ($env:TEST_CATEGORY -ne "All") {
                        $categoryArgument = "--filter `"TestCategory=$env:TEST_CATEGORY`""
                    }

                    if ($env:BROWSER -eq "All") {

                        Write-Host "Running tests on Chromium"
                        $env:BROWSER = "Chromium"

                        dotnet test "$env:PROJECT_FILE" `
                            --no-build `
                            --logger "trx;LogFileName=chromium.trx" `
                            $categoryArgument

                        Write-Host "Running tests on WebKit"
                        $env:BROWSER = "WebKit"

                        dotnet test "$env:PROJECT_FILE" `
                            --no-build `
                            --logger "trx;LogFileName=webkit.trx" `
                            $categoryArgument
                    }
                    else {

                        Write-Host "Running tests on $env:BROWSER"

                        dotnet test "$env:PROJECT_FILE" `
                            --no-build `
                            --logger "trx;LogFileName=initial.trx" `
                            $categoryArgument
                    }

                    exit 0
                '''
            }
        }

        stage('Retry Failed Tests') {
            steps {
                powershell '''
                    $retryCount = [int]$env:RETRY_COUNT

                    if ($retryCount -eq 0) {
                        Write-Host "Retry disabled."
                        exit 0
                    }

                    $trxFile = Get-ChildItem "TestResults" -Filter "*.trx" |
                        Sort-Object LastWriteTime -Descending |
                        Select-Object -First 1

                    if ($null -eq $trxFile) {
                        Write-Host "No TRX file found. Nothing to retry."
                        exit 0
                    }

                    [xml]$trx = Get-Content $trxFile.FullName

                    $failedTests = @(
                        $trx.TestRun.Results.UnitTestResult |
                        Where-Object {
                            $_.outcome -eq "Failed"
                        }
                    )

                    if ($failedTests.Count -eq 0) {
                        Write-Host "No failed tests found."
                        exit 0
                    }

                    Write-Host "Failed tests found: $($failedTests.Count)"

                    $failedTests |
                        ForEach-Object {
                            Write-Host "FAILED: $($_.testName)"
                        }

                    $remainingFailures = @($failedTests)

                    for ($attempt = 1; $attempt -le $retryCount; $attempt++) {

                        if ($remainingFailures.Count -eq 0) {
                            break
                        }

                        Write-Host "======================================"
                        Write-Host "Retry attempt $attempt"
                        Write-Host "Tests to retry: $($remainingFailures.Count)"
                        Write-Host "======================================"

                        $nextFailures = @()

                        foreach ($failedTest in $remainingFailures) {

                            $testName = $failedTest.testName

                            Write-Host "Retrying: $testName"

                            $safeName = $testName -replace '[^a-zA-Z0-9_-]', '_'

                            $retryTrx = "TestResults/retry_${attempt}_${safeName}.trx"

                            dotnet test "$env:PROJECT_FILE" `
                                --no-build `
                                --filter "FullyQualifiedName~$testName" `
                                --logger "trx;LogFileName=$([System.IO.Path]::GetFileName($retryTrx))"

                            if ($LASTEXITCODE -ne 0) {
                                $nextFailures += $failedTest
                            }
                        }

                        $remainingFailures = @($nextFailures)
                    }

                    if ($remainingFailures.Count -gt 0) {
                        Write-Host "Tests still failing after retries:"
                        $remainingFailures |
                            ForEach-Object {
                                Write-Host $_.testName
                            }
                    }
                    else {
                        Write-Host "All previously failed tests passed during retry."
                    }
                '''
            }
        }

        stage('Allure Report') {
            steps {
                script {
                    allure([
                        includeProperties: false,
                        jdk: '',
                        results: [
                            [path: 'Reports/allure-results']
                        ]
                    ])
                }
            }
        }

        stage('Archive Results') {
            steps {
                archiveArtifacts(
                    artifacts: 'TestResults/**/*.trx, Screenshots/**/*, Traces/**/*',
                    allowEmptyArchive: true
                )
            }
        }
    }

    post {

        always {

            script {

                def buildStatus = currentBuild.currentResult

                def emailBody = """
                    <html>
                    <body>

                    <h2>HRMS Automation Jenkins Build</h2>

                    <table border="1" cellpadding="6" cellspacing="0">

                    <tr>
                        <td><b>Build</b></td>
                        <td>${env.BUILD_NUMBER}</td>
                    </tr>

                    <tr>
                        <td><b>Status</b></td>
                        <td>${buildStatus}</td>
                    </tr>

                    <tr>
                        <td><b>Browser</b></td>
                        <td>${params.BROWSER}</td>
                    </tr>

                    <tr>
                        <td><b>Execution Mode</b></td>
                        <td>${params.EXECUTION_MODE}</td>
                    </tr>

                    <tr>
                        <td><b>Test Category</b></td>
                        <td>${params.TEST_CATEGORY}</td>
                    </tr>

                    <tr>
                        <td><b>Retry Count</b></td>
                        <td>${params.RETRY_COUNT}</td>
                    </tr>

                    <tr>
                        <td><b>Build Duration</b></td>
                        <td>${currentBuild.durationString}</td>
                    </tr>

                    </table>

                    <br/>

                    <h3>Reports</h3>

                    <p>
                        <a href="${env.BUILD_URL}allure/">
                            Open Detailed Allure Report
                        </a>
                    </p>

                    <p>
                        <a href="${env.BUILD_URL}">
                            Open Jenkins Build
                        </a>
                    </p>

                    </body>
                    </html>
                """

                mail(
                    to: 'YOUR_EMAIL@example.com',
                    subject: "HRMS Automation - Build #${env.BUILD_NUMBER} - ${buildStatus}",
                    body: emailBody,
                    mimeType: 'text/html',
                    attachLog: true
                )
            }
        }
    }
}